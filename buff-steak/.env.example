PORT=3001
BASE_URL=http://localhost:3001

# 正式上線網址（Render 設為 https://steak.bafuholdings.com）
# BASE_URL=https://steak.bafuholdings.com

# 訂位 / 加盟 Email 通知（可與店長簡訊並用）
RESTAURANT_EMAIL=your@email.com

# Resend（優先）— 與 GhostBreak 相同設定即可
RESEND_API_KEY=re_your_key
RESEND_FROM="BUFF STEAK <noreply@bafuholdings.com>"

# 或 SMTP 備援
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM="八斧牛排 <your@gmail.com>"

# Twilio 簡訊 — 訂位成功後通知各店店長（與 GhostBreak 相同帳號即可）
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_FROM_NUMBER=+18559142394
# Trial 帳戶簡訊限 70 字；付費帳戶設 false
TWILIO_TRIAL_MODE=true

# 各店店長手機（多支請用逗號分隔，例：0903593595,0916893857）
SHENKENG_MANAGER_PHONE=0916893857
SHILIN_MANAGER_PHONE=0911969178

# 總部改收 Email（RESTAURANT_EMAIL），不再發總部簡訊
# RESERVE_NOTIFY_PHONES=
# FRANCHISE_NOTIFY_PHONE=

# 本機測試用：true = 不發店長簡訊（總部仍收 Email）
# 正式上線前請改為 false，或改用 start-正式.bat
SMS_TEST_MODE=false

# Google Analytics 4（analytics.google.com → 管理 → 資料串流 → 評估 ID）
# 建議為 steak.bafuholdings.com 另開一個資料串流，不要跟 GhostBreak 共用同一個 G-
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# 訂位後台密碼（https://steak.bafuholdings.com/admin）
# 請設成只有店長知道的密碼；正式站請在 Render 設同一個值
ADMIN_PASSWORD=change-me-now
