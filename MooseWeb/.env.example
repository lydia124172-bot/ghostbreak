PORT=3002
BASE_URL=http://127.0.0.1:3002
# 正式上線：https://moose.bafuholdings.com

# 後台密碼（http://127.0.0.1:3002/admin）
ADMIN_PASSWORD=moneyweb

# 諮詢表單寄到這個信箱
INQUIRE_EMAIL=lydia3530@gmail.com

# Resend（與八斧／GhostBreak 同一組即可）
RESEND_API_KEY=re_your_key
RESEND_FROM="MooseWeb <noreply@bafuholdings.com>"

# MooseClip 自動發文與商店連接（審核通過後設 CLIP_CONNECT_OPEN=1 再開）
CLIP_CONNECT_OPEN=
# MooseClip 自動發文（官方應用，未填仍可出片下載）
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# MooseClip Shopify 一鍵安裝（客人授權，像 Minta；回呼須列入 Partner 應用）
# https://moose.bafuholdings.com/api/clip/shop/oauth/shopify/callback
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# MooseClip 識圖寫文案與進階生圖（同一把 GEMINI_API_KEY；生圖需 Google 帳單）
OPENAI_API_KEY=
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# 進階生圖預設走 Google。只有設 CLIP_IMAGE_ENGINE=fal 才扣 fal
FAL_KEY=
# CLIP_IMAGE_ENGINE=fal
# FAL_IMAGE_MODEL=fal-ai/bytedance/seedream/v4/edit
# 小廣告圖生視頻（Wan 2.6，10 秒約 USD 1）
# FAL_VIDEO_MODEL=wan/v2.6/image-to-video
# FAL_VIDEO_DURATION=10
# FAL_VIDEO_CREDITS=3
# 劇本廣告 StoryClip。有 ARK_API_KEY 就走 BytePlus（約 USD 0.12／秒），否則走 fal
# STORY_VIDEO_ENGINE=byteplus
# ARK_API_KEY=
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# ARK_STORY_MODEL=dreamina-seedance-2-0-fast-260128
# FAL_STORY_MODEL=bytedance/seedance-2.0/fast/image-to-video
# FAL_STORY_T2V_MODEL=bytedance/seedance-2.0/fast/text-to-video
# FAL_STORY_DURATION=10
# FAL_STORY_CREDITS=1
# AI短劇 DramaClip（三鏡×5 秒 Wan，約 USD 1.5）
# FAL_DRAMA_CREDITS=1
# FAL_TALK_MODEL=fal-ai/sync-lipsync/v3/image-to-video
# FAL_TALK_CREDITS=5
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore

# 綠界全方位金流（自建站 API，不要用 Shopify 外掛網址）
# 正式付款須 BASE_URL 為可被綠界打到的 https 網址
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# 測試特店設 1；正式收款請留空
ECPAY_STAGE=
