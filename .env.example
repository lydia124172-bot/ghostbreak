# ═══════════════════════════════════════════════════════════════
# PayPal Sandbox 設定說明
# ═══════════════════════════════════════════════════════════════
# 1. 前往 https://developer.paypal.com/dashboard/
# 2. 左側 Apps & Credentials → Sandbox（不是 Testing Tools → Sandbox Accounts）
# 3. 建立 App（或點進 Default Application）
# 4. 複製 Client ID 與 Secret 到下方
#
# 截圖中的「Sandbox Personal Account」（sb-xxx@personal.example.com）
# 是「買家測試帳號」— 只在 PayPal 付款彈窗登入時使用，不要填進 .env
# ═══════════════════════════════════════════════════════════════
PAYPAL_CLIENT_ID=your_live_client_id
PAYPAL_CLIENT_SECRET=your_live_client_secret
PAYPAL_MODE=live

# ── Resend 營運級真實發信（優先）──
# 實際發信 From 由 services/privacy.js 依 DOMAIN_NAME 硬編碼為 noreply@<DOMAIN_NAME>
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM="GhostBreak 匿名代傳服務 <noreply@bafuholdings.com>"

# 營運網域（Cloudflare DNS）
DOMAIN_NAME=bafuholdings.com

# ── 匿名 Email（Nodemailer 備援）──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="GhostBreak 匿名代傳服務 <noreply@bafuholdings.com>"
EMAIL_REPLY_TO=

# ── Twilio 真實簡訊 ──
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_32_char_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_TEST_TO=+8869xxxxxxxx
# Trial 帳戶設 true（簡訊自動壓縮為單段 70 字）；升級付費後改 false
TWILIO_TRIAL_MODE=true

# Google reCAPTCHA v3（防刷簡訊）
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
RECAPTCHA_MIN_SCORE=0.5

# 網站
BASE_URL=http://localhost:3000
PORT=3000

# 後台密碼（正式站務必設定；本地可留空方便開發）
ADMIN_PASSWORD=your_admin_password_here

# Google Analytics 4（analytics.google.com → Admin → Data Streams → Measurement ID）
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# 訂單持久化目錄（Render 正式站用 /var/data）
# DATA_DIR=/var/data

# ── Render 正式站（在 Render Dashboard 設定，勿提交 .env）──
# NODE_ENV=production
# BASE_URL=https://bafuholdings.com
# RECAPTCHA_DEV_BYPASS=false
# ALLOW_MOCK_PAY=false
# PAYPAL_MODE=live   # 正式收款（Sandbox 測試用 sandbox）
